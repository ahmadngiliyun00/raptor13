# Contoh .htaccess untuk RAPTOR13 di OpenLiteSpeed (CyberPanel) atau Apache.
# Salin ke akar situs sebagai .htaccess. Di CyberPanel: Websites, Manage, Rewrite Rules menerima aturan
# rewrite; header di bawah butuh modul headers (aktif bawaan di OpenLiteSpeed 1.7 ke atas).
# Setelah mengubah, mulai ulang server: sudo systemctl restart lsws
# Dokumentasi lengkap dan perintah verifikasi: docs/deploy/security-headers.md

Options -Indexes
ServerSignature Off

RewriteEngine On

# 1. HTTP ke HTTPS (301)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Blokir berkas tersembunyi (.git, .env, .htaccess, .DS_Store, dan lainnya) dan berkas pengembangan
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(docs|tests|node_modules|test-results|playwright-report)(/|$) - [F,L]
RewriteRule ^(package\.json|package-lock\.json|playwright\.config\.mjs|README\.md|CHANGELOG\.md)$ - [F,L]

<IfModule mod_headers.c>
  # HSTS: aktifkan includeSubDomains dan preload hanya bila semua subdomain sudah HTTPS
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), browsing-topics=(), interest-cohort=(), fullscreen=(self), screen-wake-lock=(self), autoplay=(self)"
  # Kebijakan kasar di header (tanpa hash agar tidak perlu diubah tiap rilis). Kebijakan ketat dengan
  # hash skrip ada di meta CSP index.html; browser menegakkan keduanya sekaligus (irisan).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self'; font-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By
  Header always unset X-Powered-By

  # Cache: halaman selalu divalidasi ulang, aset pihak ketiga berversi di vendor/three-0.187.0/ boleh lama
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|ico|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/vendor/three-0\.187\.0/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Tipe MIME
AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs

# Kompresi: Brotli bila tersedia, selain itu gzip
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
